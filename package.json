{
  "name": "web-audio-step-sequencer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:defaults": "tsx scripts/verify-defaults.ts",
    "verify:store": "tsx scripts/verify-store.ts",
    "verify:render": "tsx scripts/verify-render.tsx",
    "verify:engine": "tsx scripts/verify-engine.ts",
    "verify:hydration": "tsx scripts/verify-hydration.tsx",
    "verify": "pnpm run typecheck && pnpm run verify:defaults && pnpm run verify:store && pnpm run verify:render && pnpm run verify:engine && pnpm run verify:hydration",
    "gate": "pnpm run verify && pnpm run build"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/jsdom": "^30.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.1.1",
    "postcss": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
